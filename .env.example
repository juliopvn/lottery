# Copia este archivo a .env.local y ajusta los valores.
# .env.local y .env*.local NUNCA se suben al repositorio (ver .gitignore).

# --- App ---
APP_URL=http://localhost:3000
NODE_ENV=development

# --- MongoDB ---
# Local: mongodb://localhost:27017 (docker-compose). En producción (Atlas)
# usa mongodb+srv://... SIN nombre de base de datos en la ruta.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=lottery

# --- Auth ---
# Genera uno nuevo por entorno, mínimo 32 caracteres. Ejemplo: openssl rand -base64 48
JWT_SECRET=cambia-esto-por-un-secreto-de-al-menos-32-caracteres
MAGIC_LINK_TTL_MINUTES=15
ADMIN_EMAIL=admin@example.com

# --- Stripe (siempre en modo test para este proyecto) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_CURRENCY=mxn

# --- Email: "mailhog" en local, "resend" en producción ---
EMAIL_PROVIDER=mailhog
EMAIL_FROM="Lottery <no-reply@mail.jpavon-tech.com>"
MAILHOG_HOST=localhost
MAILHOG_PORT=1025
RESEND_API_KEY=re_...

# --- Tests ---
# E2E=1 habilita rutas de soporte para pruebas (/api/test/*). NUNCA en producción.
E2E=0
E2E_REAL_STRIPE=0

# --- Despliegue (solo como GitHub Secrets, nunca en .env.local) ---
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
