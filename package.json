{
  "name": "lottery",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "seed": "tsx scripts/seed.ts",
    "seed:reset": "tsx scripts/seed.ts --reset",
    "seed:e2e": "tsx scripts/seed.ts --e2e --reset",
    "db:indexes": "tsx scripts/create-indexes.ts"
  },
  "dependencies": {
    "jose": "6.2.12",
    "mongodb": "7.7.0",
    "next": "16.3.7",
    "nodemailer": "10.0.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.31.0",
    "stripe": "22.6.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/nodemailer": "8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "5.0.2",
    "dotenv": "18.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "mongodb-memory-server": "11.3.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "mongodb-memory-server@11.3.0": true,
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true
  }
}
